# 飞书开放平台：凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 路由器 SSH
ROUTER_HOST=192.168.31.1
ROUTER_PORT=22
ROUTER_USER=root

# 二选一：新手可以先用密码；更安全建议后续改为 SSH_KEY_PATH
ROUTER_PASSWORD=请改成你的路由器密码
# SSH_KEY_PATH=/app/keys/shellcrash_bot_key

# 安全控制：首次部署可先 ALLOW_ALL_USERS=true，发 /whoami 获取自己的 open_id 后再改为 false
ALLOW_ALL_USERS=true
ALLOWED_OPEN_IDS=
# 可选：只允许指定群聊/单聊，不填则不限制。先发 /whoami 可查看 chat_id
ALLOWED_CHAT_IDS=

# 日志和输出长度
LOG_LEVEL=INFO
MAX_REPLY_CHARS=3200
